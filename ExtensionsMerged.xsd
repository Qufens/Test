<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:simpleType name="idguidtype">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="idtype">
		<xs:annotation>
			<xs:documentation>
				Is the unique identifier.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z_]([A-Za-z0-9_])*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="languagecode">
		<xs:annotation>
			<xs:documentation>
				ISO language code.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-z]{2}(-[A-Z]{2})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="textwithdotallowed">
		<xs:restriction base="xs:string">
			<xs:pattern value="[\w.]*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="textwithdashallowed">
		<xs:restriction base="xs:string">
			<xs:pattern value="[\w-]*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="assemblyorclassnametype">
		<xs:restriction base="xs:string">
			<xs:pattern value="[^.]([A-Za-z0-9_.])*[^.]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="majorminorpatchversiontype">
		<xs:restriction base="xs:string">
			<xs:pattern value="([0-9]+)\.([0-9]+)\.([0-9]+)"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="nowhitespacestringtype">
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z_]([A-Za-z0-9_])*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="existingtype">
		<xs:annotation>
			<xs:documentation>
				Indicates whether an existing standard control is being customized. Set this attribute to true and specify the ID of the standard control to extend. The default is false.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>
	<xs:simpleType name="showinnewtabtype">
		<xs:annotation>
			<xs:documentation>
				Indicates whether the link should open in a new tab. Use this attribute for non-EOL URLs when the link must open in a new tab.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>
	<xs:simpleType name="termidtype">
		<xs:annotation>
			<xs:documentation>
				The existing Exact Online term ID that refers to a predefined caption text.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:unsignedInt"/>
	</xs:simpleType>
	<xs:simpleType name="featuresettype">
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z_]([A-Za-z0-9_])*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="extensioncodetype">
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Z]{3,5}_[_A-Za-z0-9]+"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="applicationtype">
		<xs:restriction base="xs:string">
			<xs:pattern value="([A-Za-z0-9_.-])+\.aspx"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="hreftype">
		<xs:restriction base="xs:string">
			<!-- 
				Allows http:// or https:// 
				Domain address can have colon : or underscore _
				Special characters allowed after the hostname are as below.
					 @%_+.~#?;&/={}()',
				Other special characters must be escaped.
				Disallows name with @ before the domain address (e.g. http://myName@www.google.com)
			-->
			<xs:pattern value="((http(s)?:\/\/[-a-zA-Z0-9._]{1,256}(:[0-9]{2,6})?(\/?[-a-zA-Z0-9%_\+.~#?;&amp;={}()',&lt;&gt;/:]*)?)|(\/?[-a-zA-Z0-9%_\+.~#;&amp;={}()',&lt;&gt;/]+(\?[-a-zA-Z0-9%_\+.~#;&amp;={}()',&lt;&gt;/:]*)?)?)"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="legislationtype">
		<xs:annotation>
			<xs:documentation>
				Restricts the visibility of the custom UI control to one or more legislations.
			</xs:documentation>
		</xs:annotation>
		<xs:list>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="Any"/>
					<xs:enumeration value="Netherlands"/>
					<xs:enumeration value="Belgium"/>
					<xs:enumeration value="Germany"/>
					<xs:enumeration value="NetherlandsAntilles"/>
					<xs:enumeration value="Turkey"/>
					<xs:enumeration value="Luxembourg"/>
					<xs:enumeration value="UnitedKingdom"/>
					<xs:enumeration value="France"/>
					<xs:enumeration value="UnitedStates"/>
					<xs:enumeration value="Spain"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:list>
	</xs:simpleType>
	<xs:simpleType name="featurechecktype">
		<xs:annotation>
			<xs:documentation>
				Specifies how feature-set checks are evaluated. Supported values are All, Any, and None.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="All"/>
			<xs:enumeration value="Any"/>
			<xs:enumeration value="None"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="permissiontype">
		<xs:annotation>
			<xs:documentation>
				Specifies one or more permissions for the action. Supported values are None, View, Update, Create, Delete, and Full.
			</xs:documentation>
		</xs:annotation>
		<xs:list>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="None"/>
					<xs:enumeration value="View"/>
					<xs:enumeration value="Update"/>
					<xs:enumeration value="Create"/>
					<xs:enumeration value="Delete"/>
					<xs:enumeration value="Full"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:list>
	</xs:simpleType>
	<xs:simpleType name="propertytypetype">
		<xs:annotation>
			<xs:documentation>
				Represents the data type of the property or column. Supported values are string, boolean, integer, double, date, guid, and numericstring.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="string"/>
			<xs:enumeration value="boolean"/>
			<xs:enumeration value="integer"/>
			<xs:enumeration value="double"/>
			<xs:enumeration value="date"/>
			<xs:enumeration value="guid"/>
			<xs:enumeration value="numericstring"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="customentitypropertytypetype">
		<xs:annotation>
			<xs:documentation>
				Represents the data type of the custom entity property or column. Supported values are string, boolean, integer, double, date, guid, numericstring, and picture.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="string"/>
			<xs:enumeration value="boolean"/>
			<xs:enumeration value="integer"/>
			<xs:enumeration value="double"/>
			<xs:enumeration value="date"/>
			<xs:enumeration value="guid"/>
			<xs:enumeration value="numericstring"/>
			<xs:enumeration value="picture"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="workflowpropertytypetype">
		<xs:annotation>
			<xs:documentation>
				Represents the data type of the Workflow property or column. Supported values are string, boolean, integer, double, date, guid, numericstring, picture, and attachment.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="string"/>
			<xs:enumeration value="boolean"/>
			<xs:enumeration value="integer"/>
			<xs:enumeration value="double"/>
			<xs:enumeration value="date"/>
			<xs:enumeration value="guid"/>
			<xs:enumeration value="numericstring"/>
			<xs:enumeration value="picture"/>
			<xs:enumeration value="attachment"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="settingtype">
		<xs:annotation>
			<xs:documentation>
				Represents the data type of the setting. Supported values are string, boolean, integer, double, date, and numericstring.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="string"/>
			<xs:enumeration value="boolean"/>
			<xs:enumeration value="integer"/>
			<xs:enumeration value="double"/>
			<xs:enumeration value="date"/>
			<xs:enumeration value="numericstring"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="fieldtypetype">
		<xs:annotation>
			<xs:documentation>
				Represents the data type of the field. Supported values are string, boolean, integer, double, date, guid, hyperlink, picture, and attachment.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="string"/>
			<xs:enumeration value="boolean"/>
			<xs:enumeration value="integer"/>
			<xs:enumeration value="double"/>
			<xs:enumeration value="date"/>
			<xs:enumeration value="guid"/>
			<xs:enumeration value="hyperlink"/>
			<xs:enumeration value="picture"/>
			<xs:enumeration value="attachment"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="gridcolumntypetype">
		<xs:annotation>
			<xs:documentation>
				Represents the data type of the grid column. Supported values are string, boolean, integer, double, date, and guid.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="string"/>
			<xs:enumeration value="boolean"/>
			<xs:enumeration value="integer"/>
			<xs:enumeration value="double"/>
			<xs:enumeration value="date"/>
			<xs:enumeration value="guid"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="referstotype">
		<xs:annotation>
			<xs:documentation>
				Specifies the referenced standard entity name. This attribute is used with properties of type guid.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Item"/>
			<xs:enumeration value="Account"/>
			<xs:enumeration value="Project"/>
			<xs:enumeration value="Opportunity"/>
			<xs:enumeration value="SalesOrder"/>
			<xs:enumeration value="Contact"/>
			<xs:enumeration value="User"/>
			<xs:enumeration value="Employee"/>
			<xs:enumeration value="Document"/>
			<xs:enumeration value="GLAccount"/>
			<xs:enumeration value="Team"/>
			<xs:enumeration value="Costcenter"/>
			<xs:enumeration value="Costunit"/>
			<xs:enumeration value="Journal"/>
			<xs:enumeration value="Quotation"/>
			<xs:enumeration value="PurchaseOrder"/>
			<xs:enumeration value="ShopOrder"/>
			<xs:enumeration value="Subscription"/>
			<xs:enumeration value="SalesInvoice"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="controltypetype">
		<xs:annotation>
			<xs:documentation>
				Specifies the control type. Supported values are default, textarea, checkboxlist, list, radiobuttonlist, and inputfield.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="default"/>
			<xs:enumeration value="textarea"/>
			<xs:enumeration value="checkboxlist"/>
			<xs:enumeration value="list"/>
			<xs:enumeration value="radiobuttonlist"/>
			<xs:enumeration value="inputfield"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="fieldcontroltype">
		<xs:annotation>
			<xs:documentation>
				Specifies the field control type. Supported values are default, textarea, list, radiobuttonlist, and inputfield.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="default"/>
			<xs:enumeration value="textarea"/>
			<xs:enumeration value="list"/>
			<xs:enumeration value="radiobuttonlist"/>
			<xs:enumeration value="inputfield"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="custompropertyrelationtype">
		<xs:annotation>
			<xs:documentation>
				Specifies the relation type for a functional component extension. Currently only ExpressionDefault is supported.
			</xs:documentation>
		</xs:annotation>
		<xs:list>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="ExpressionDefault"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:list>
	</xs:simpleType>
	<xs:simpleType name="megamenuidtype">
		<xs:restriction base="xs:string">
			<xs:enumeration value="MegaMenu"/>
			<xs:enumeration value="MegaMenuLocked"/>
			<xs:enumeration value="MegaMenuViewUser"/>
			<xs:enumeration value="MegaMenuInvoiceUser"/>
			<xs:enumeration value="MegaMenuApproverUser"/>
			<xs:enumeration value="MegaMenuClient"/>
			<xs:enumeration value="MegaMenuDeclaration"/>
			<xs:enumeration value="MegaMenuESS"/>
			<xs:enumeration value="MegaMenuExactGo"/>
			<xs:enumeration value="MegaMenuInvoiceUserE4B"/>
			<xs:enumeration value="MegaMenuTBPortal"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="quickmenuidtype">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Accountancy"/>
			<xs:enumeration value="Accounting"/>
			<xs:enumeration value="Manufacturing"/>
			<xs:enumeration value="PS"/>
			<xs:enumeration value="Wholesale"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="returntypetype">
		<xs:annotation>
			<xs:documentation>
				Specifies the Azure function return type. Supported values are Bool, Int, Long, Double, String, and DateTime.
			</xs:documentation>
		</xs:annotation>
		<xs:list>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="Bool"/>
					<xs:enumeration value="Int"/>
					<xs:enumeration value="Long"/>
					<xs:enumeration value="Double"/>
					<xs:enumeration value="String"/>
					<xs:enumeration value="DateTime"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:list>
	</xs:simpleType>
	<xs:simpleType name="propertyStates">
		<xs:annotation>
			<xs:documentation>
				Specifies one or more property states: None, AfterAddNew, BeforeInsert, BeforeUpdate, OnValidate, Fixed, Overwrite, AfterEdit, or AfterCopy. Separate multiple values with a space.
			</xs:documentation>
		</xs:annotation>
		<xs:list>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="None"/>
					<xs:enumeration value="AfterAddNew"/>
					<xs:enumeration value="BeforeInsert"/>
					<xs:enumeration value="BeforeUpdate"/>
					<xs:enumeration value="OnValidate"/>
					<xs:enumeration value="Fixed"/>
					<xs:enumeration value="Overwrite"/>
					<xs:enumeration value="AfterEdit"/>
					<xs:enumeration value="AfterCopy"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:list>
	</xs:simpleType>
	<xs:simpleType name="stagetypetype">
		<xs:restriction base="xs:string">
			<xs:enumeration value="None"/>
			<xs:enumeration value="New"/>
			<xs:enumeration value="Canceled"/>
			<xs:enumeration value="Restarted"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="powerbireportembeddedlink">
		<xs:annotation>
			<xs:documentation>
				The report link to embed. Make sure the URL is XML-escaped: every ampersand symbol must be written as &amp;.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="hreftype">
			<xs:pattern value="(http[s]?:\/\/)(app.powerbi.com\/reportEmbed\?)(.{0,})"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="googlesheetsembeddedlink">
		<xs:annotation>
			<xs:documentation>
				URL of the Google Sheets document to embed. Obtain the URL from File > Share > Embed. The URL must start with docs.google.com.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="hreftype">
			<xs:pattern value="(http[s]?:\/\/)(docs.google.com\/spreadsheets\/d\/)(.{0,})"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="listitemstringtype">
		<xs:restriction base="xs:string">
			<xs:pattern value="[^,;]*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="translationidtype">
		<xs:annotation>
			<xs:documentation>
				Unique ID that refers to a translation defined in the translationextensions element in the XML.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="nowhitespacestringtype">
			<xs:maxLength value="100"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="sqltablecolumnlength">
		<xs:restriction base="nowhitespacestringtype">
			<xs:maxLength value="124"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="deleteactiontype">
		<xs:annotation>
			<xs:documentation>
				Specifies the delete behavior for a property that references another entity. Supported values are setnull and restrict.
			</xs:documentation>
		</xs:annotation>
		<xs:list>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="setnull"/>
					<xs:enumeration value="restrict"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:list>
	</xs:simpleType>
	<xs:simpleType name="stringmaxlength255">
		<xs:annotation>
			<xs:documentation>
				Maximum length of the value is 255 characters.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stringmaxlength60">
		<xs:annotation>
			<xs:documentation>
				Maximum length of the value is 60 characters.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="60"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="unsignedinttype4000">
		<xs:annotation>
			<xs:documentation>
				An unsigned integer between 1 and 4000, used to specify the maximum length of a string property
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:unsignedInt">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="4000"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="unsignedinttype10">
		<xs:annotation>
			<xs:documentation>
				A number from 0 to 10, available for double properties and columns, representing the number of digits after the decimal separator.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:unsignedInt">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="10"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="mandatoryfeaturesetstype">
		<xs:annotation>
			<xs:documentation>
				Feature sets that must be enabled for the UI control to be shown.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="featureset" type="featuresettype" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="forbiddenfeaturesetstype">
		<xs:annotation>
			<xs:documentation>
				Feature sets that prevent the UI control from being shown.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="featureset" type="featuresettype" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="azurefunctionstype">
		<xs:annotation>
			<xs:documentation>
				Contains definitions of Azure functions that can be called from extensions.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="function" type="functiontype" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="functiontype">
		<xs:sequence>
			<xs:element name="endpoint" type="hreftype" minOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Endpoint URL of the Azure function hosted in Azure.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="authorization" minOccurs="1">
				<xs:complexType>
					<xs:sequence>
						<xs:choice>
							<xs:element name="keyvault">
								<xs:complexType>
									<xs:attribute name="endpoint" type="xs:string" use="required">
										<xs:annotation>
											<xs:documentation>
												Vault URI of the Azure Key Vault, for example: https://{keyvault-name}.vault.azure.net/
											</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="secret" type="xs:string" use="required">
										<xs:annotation>
											<xs:documentation>
												Name of the secret stored in Azure Key Vault. Key Vault provides secure storage for secrets such as passwords and connection strings.
											</xs:documentation>
										</xs:annotation>
									</xs:attribute>
								</xs:complexType>
							</xs:element>
							<xs:element name="apikey" type="xs:string">
								<xs:annotation>
									<xs:documentation>
										Azure Function API key as configured in the Azure portal for the function. Specify either an API key or a Key Vault reference.
									</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="parameters">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="parameter" minOccurs="1" maxOccurs="unbounded">
							<xs:complexType>
								<xs:attribute name="name" type="xs:string" use="required">
									<xs:annotation>
										<xs:documentation>
											Azure Function parameter name.
										</xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="caption" type="xs:string" use="required">
									<xs:annotation>
										<xs:documentation>
											Parameter caption shown in the Expression Editor Azure Function signature.
										</xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="required" type="xs:boolean" use="optional">
									<xs:annotation>
										<xs:documentation>
											Boolean value that indicates whether the parameter is mandatory.
										</xs:documentation>
									</xs:annotation>
								</xs:attribute>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="name" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>
					The name of the Azure function as defined in Azure.
				</xs:documentation>

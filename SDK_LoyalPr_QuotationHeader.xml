	<entities>
		<entity name="Account" table="Accounts" extensiontable="SDK_LoyalPr_Accounts" businesscomponent="Account">
			<property name="SDK_LoyalPrLoyaltyMember" columnname="LoyaltyMember" type="boolean" caption="Loyalty member" />
			<property name="SDK_LoyalPrLoyaltyCard" columnname="LoyaltyCard" caption="Loyalty card" type="string" length="18" allowempty="false" />
			<property name="SDK_LoyalPrLoyaltyDiscount" columnname="LoyaltyDiscount" caption="Loyalty discount" type="double" scale="4" />
			<property name="SDK_LoyalPrLoyaltyCardValidity" columnname="LoyaltyCardValidity" caption="Loyalty Card Validity" type="date" />
			<property name="SDK_LoyalPrLoyaltyLevel" columnname="LoyaltyLevel" type="integer" caption="Loyalty level">
				<listitems allowempty="true" listdefinitionid="LoyaltyLevelList">
					<listitem value="1" caption="Entry" />
					<listitem value="3" caption="Gold" translationid="SDK_LoyalPrGoldTranslated" />
					<listitem value="2" caption="Silver" />
					<listitem value="4" caption="Platinum" translationid="SDK_LoyalPrplatinumTranslated" />
				</listitems>
			</property>
			<property name="SDK_LoyalPrAccount" columnname="Account" caption="Extension Account" type="guid" refersto="Account" />
			<property name="SDK_LoyalPrProject" columnname="Project" caption="Extension Project" type="guid" refersto="Project" />
			<property name="SDK_LoyalPrContact" columnname="Contact" caption="Extension Contact" type="guid" refersto="Contact" />
			<property name="SDK_LoyalPrOpportunity" columnname="Opportunity" caption="Extension Opportunity" type="guid" refersto="Opportunity" />
			<property name="SDK_LoyalPrSalesOrder" columnname="SalesOrder" caption="Extension SalesOrder" type="guid" refersto="SalesOrder" />
			<property name="SDK_LoyalPrItem" columnname="Item" caption="Extension Item" type="guid" refersto="Item" />
			<property name="SDK_LoyalPrGLAccount" columnname="GLAccount" caption="Extension G/L Account" type="guid" refersto="GLAccount" />
			<property name="SDK_LoyalPrCostcenter" columnname="Costcenter" caption="Extension Costcenter" type="guid" refersto="Costcenter"/>
			<property name="SDK_LoyalPrCostunit" columnname="Costunit" caption="Extension Costunit" type="guid" refersto="Costunit"/>
			<property name="SDK_LoyalPrLoyaltyRemarks" columnname="LoyaltyRemarks" caption="Loyalty remarks" type="string" length="400" />
			<property name="SDK_LoyalPrJournal" columnname="Journal" caption="Extension Journal" type="guid" refersto="Journal" />
			<property name="SDK_LoyalPrQuotationHeaders" columnname="Quotation" caption="Extension Quotation" type="guid" refersto="Quotation" />
			<property name="SDK_LoyalPrPurchaseOrder" columnname="PurchaseOrder" caption="Extension PurchaseOrder" type="guid" refersto="PurchaseOrder" />
			<property name="SDK_LoyalPrShopOrder" columnname="ShopOrder" caption="Extension ShopOrder" type="guid" refersto="ShopOrder" />
		</entity>
		<!--
		For the invoice creation process to take over extension properties, it is necessary that the relevant extension
		have identical names (name attribute) in the SalesInvoiceLine and the SalesOrderLine entities.
		If that is the case, then copying the corresponding property values in the invoice creation process is automatic.
		-->
		<entity name="SalesTransaction" table="SalesTransactions" extensiontable="SDK_LoyalPr_SalesTransactions" businesscomponent="SalesInvoiceLine">
			<property name="SDK_LoyalPrLoyaltyColor" columnname="LoyaltyColor" caption="Color" type="string" length="30" />
			<!-- numericstring -->
			<property name="SDK_LoyalPrEANNumber" columnname="EANNumber" caption="EAN number" type="numericstring" length="18" />
			<!-- guid -->
			<property name="SDK_LoyalPrSupplier" columnname="Account" type="guid" refersto="Account" caption="Supplier" />
		</entity>
		<entity name="SalesOrder" table="SalesOrderLines" extensiontable="SDK_LoyalPr_SalesOrders" businesscomponent="SalesOrderLine">
			<property name="SDK_LoyalPrLoyaltyColor" columnname="LoyaltyColor" caption="Color" type="string" length="30" />
			<property name="SDK_LoyalPrEANNumber" columnname="EANNumber" caption="EAN number" type="numericstring" length="18" />
			<property name="SDK_LoyalPrSupplier" columnname="Account" type="guid" refersto="Account" caption="Supplier" />
		</entity>
		<entity name="SalesTransaction" table="SalesTransactions" extensiontable="SDK_LoyalPr_SalesInvoiceHeaders" businesscomponent="SalesInvoiceHeader">
			<property name="SDK_LoyalPrLoyaltyDiscount" columnname="LoyaltyDiscount" caption="Loyalty discount" type="double" />
			<property name="SDK_LoyalPrLoyaltyLevel" columnname="LoyaltyLevel" type="integer" caption="Loyalty level">
				<listitems allowempty="true" listdefinitionid="LoyaltyLevelList">
					<listitem value="1" caption="Entry" />
					<listitem value="3" caption="Gold" />
					<listitem value="2" caption="Silver" />
					<listitem value="4" caption="Platinum" />
				</listitems>
			</property>
		</entity>
		<entity name="GLTransaction" table="GLTransactions" extensiontable="SDK_LoyalPr_GLTransactions" businesscomponent="CashflowEntryOffsetLine">
			<property name="SDK_LoyalPrBankName" columnname="BankName" caption="Bank name" type="string" length="34" />
			<property name="SDK_LoyalPrIban" columnname="Iban" caption="Iban" type="string" length="34" />
		</entity>
		<entity name="Subscription" table="Subscriptions" extensiontable="SDK_LoyalPr_Subscriptions" businesscomponent="SubscriptionLine">
			<property name="SDK_LoyalPr_FullText_IndexTest" columnname="FullText_IndexTest" caption="Full Text Index Test" type="string" length="34" />
		</entity>
		<entity name="Item" businesscomponent="Item" table="Items" extensiontable="SDK_LoyalPr_Items">
			<property name="SDK_LoyalPrAccount" columnname="Account" caption="Extension Customer" type="guid" refersto="Account" />
		</entity>
		<entity name="PurchaseEntryLine" table="GLTransactions" extensiontable="SDK_LoyalPr_PurchaseEntryLines" businesscomponent="PurchaseEntryLine">
			<property name="SDK_LoyalPr_Kandidaat" columnname="Kandidaat" type="string" caption="Candidate" length="100" />
		</entity>
		<entity name="SalesOrderHeader" table="SalesOrderHeaders" extensiontable="SDK_LoyalPr_SalesOrderHeader" businesscomponent="SalesOrderHeader">
			<property name="SDK_LoyalPrSalesOrderTotalDiscount" columnname="TotalDiscount" caption="Total discount Sales Order" type="double"/>
			<property name="SDK_LoyalPrSalesOrderTotalItem" columnname="TotalItems" caption="Total items Sales Order" type="integer"/>
		</entity>
		<entity name="ShopOrder" table="ShopOrders" extensiontable="SDK_LoyalPr_ShopOrders" businesscomponent="ShopOrder">
			<property name="SDK_LoyalPr_CartNumber" columnname="CartNumber" type="string" caption="Cart number" length="30" />
		</entity>
		<entity name="SalesQuotationHeader" table="QuotationHeaders" extensiontable="SDK_LoyalPr_QuotationHeader" businesscomponent="SalesQuotationHeader">
			<property name="SDK_LoyalPrQuotationTotalQuantity" columnname="TotalQuantity" caption=" Total quantity Sales Quotation" type="integer"/>
		</entity>
	</entities>

	<businesscomponentextensions>
		<businesscomponent name="SalesInvoiceLine">

			<!-- You can reference a new property (type guid) in the same extension file -->
			<references>
				<reference forproperty="SDK_LoyalPrSupplier">
					<property name="SDK_LoyalPrSupplier_City" columnname="City" />
				</reference>
			</references>
		</businesscomponent>
		<businesscomponent name="Account">
			<!--
		***** IMPORTANT *****
        - Extends functional validations for business components
        - Validation logic is written in Azure function exposed with the endpoint specified in azurefunctionendpoint
        - API key for the HTTP Triggered azure function is kept in Keyvault maintained by Exact and a reference to the key is set here with azuresecretref attribute
		- azuresecretref can only contain alphanumeric charecters and '-'
        - Multiple functional components can use a same azure function
        - targetproperty for a functionalcomponent refers to the name of the field to be validated
        - azureoperationname refers to the operation within the azure function            
	-->
			<!--
			<azurevalidations azurefunctionendpoint="https://auroraplatformfunctionvalidator.azurewebsites.net" azuresecretref="SDK-LoyalPr-EmailValidatorFunctionAPIKeyRef">
				<functionalcomponent targetproperty="Email" azureoperationname="ValidateEmail"/>
			</azurevalidations>-->
			<references>
				<!--You can also define reference properties, based on a reference, 
						for which no existing readonly datasource exists-->
				<reference forproperty="SDK_LoyalPrSalesOrder">
					<property name="SDK_LoyalPrSalesOrder_SalesOrderNumber" columnname="SalesOrderNumber" />
				</reference>
			</references>
			<functionalcomponent type="ExpressionDefault" targetproperty="SDK_LoyalPrLoyaltyCard" propertyStates="AfterAddNew">
				<expression>
					Upper('ABC123')
				</expression>
			</functionalcomponent>
			<!-- Custom defaults can be defined with an expression -->
			<functionalcomponent type="ExpressionDefault" targetproperty="Email" propertyStates="AfterAddNew AfterEdit AfterCopy Overwrite">
				<expression>
					Concat('info@', 'exact', '.com')
				</expression>
			</functionalcomponent>
		</businesscomponent>
		<businesscomponent name="SalesOrderHeader">
			<references>
				<reference forproperty="OrderAccount">
					<property name="OrderAccount_Name" columnname="Name" caption="Name" captionid="0"/>
					<property name="OrderAccount_City" columnname="City" caption="City" captionid="0"/>
					<property name="OrderAccount_MainContact" columnname="MainContact" caption="MainContact" captionid="0"/>
					<property name="OrderAccount_Parent" columnname="Parent" caption="Parent" captionid="0"/>
				</reference>
				<reference forproperty="OrderAccount_MainContact">
					<property name="OrderAccount_MainContact_BusinessEmail" columnname="BusinessEmail" caption="BusinessEmail" captionid="0"/>
				</reference>
				<reference forproperty="OrderAccount_Parent">
					<property name="OrderAccount_Parent_Name" columnname="Name" caption="Name" captionid="0"/>
					<property name="OrderAccount_Parent_MainContact" columnname="MainContact" caption="MainContact" captionid="0"/>
				</reference>
				<reference forproperty="OrderAccount_Parent_MainContact">
					<property name="OrderAccount_Parent_MainContact_BusinessEmail" columnname="BusinessEmail" caption="BusinessEmail" captionid="0"/>
				</reference>
			</references>
			<functionalcomponent type="ExpressionDefault" targetproperty="SDK_LoyalPrSalesOrderTotalDiscount" propertyStates="AfterAddNew BeforeInsert BeforeUpdate Overwrite">
				<expression>
					Sum(LineValues('Discount'))
				</expression>
			</functionalcomponent>
			<functionalcomponent type="ExpressionDefault" targetproperty="SDK_LoyalPrSalesOrderTotalItem" propertyStates="AfterAddNew BeforeInsert BeforeUpdate Overwrite">
				<expression>
					Sum(LineValues('Quantity'))
				</expression>
			</functionalcomponent>
		</businesscomponent>
		<businesscomponent name="SalesQuotationHeader">
			<functionalcomponent type="ExpressionDefault" targetproperty="SDK_LoyalPrQuotationTotalQuantity" propertyStates="AfterAddNew BeforeInsert BeforeUpdate Overwrite">
				<expression>
					Sum(LineValues('Quantity'))
				</expression>
			</functionalcomponent>
		</businesscomponent>
	</businesscomponentextensions>
